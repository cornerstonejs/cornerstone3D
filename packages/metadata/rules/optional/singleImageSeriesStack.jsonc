// CR, DX and MG: one stack for each series.
//
// The default `singleImageModality` rule gives each CR, DX or MG image its own
// display set. This rule puts the single-frame images of one series into one
// stack, in the order ImageLaterality, ViewPosition, InstanceNumber.
//
// Do not use this rule when a hanging protocol needs one display set for each
// mammography view.
//
// The file puts the rule just before the default `singleImageModality` rule, which
// would otherwise give one display set for each image.
// `$spliceById` needs `spliceById` of @cornerstonejs/metadata, registered with
// immutability-helper `extend`.
{
  // New rules for the registry.
  "displaySetRules": {
    "$merge": {
      "singleImageSeriesStack": {
        "description": "CR / DX / MG single images: one stack for each series. CR and DX only up to singleImageSeriesMaxImages images.",
        "context": {
          // The limit applies to CR and DX: a larger series keeps one display set
          // for each image. The limit does not apply to MG. Change the value here,
          // for example with a $merge on this rule.
          "singleImageSeriesMaxImages": 9,
          "fitsSingleImageStack": "Modality == 'MG' || seriesInstanceCount <= singleImageSeriesMaxImages"
        },
        "matches": {
          "Modality": ["CR", "DX", "MG"],
          "isImage": true,
          "isMultiFrame": false,
          "fitsSingleImageStack": true
        },
        "groupBy": ["SeriesInstanceUID"],
        "sortBy": ["ImageLaterality", "ViewPosition", "InstanceNumber"]
      }
    }
  },
  "displaySetRuleOrder": {
    "$spliceById": [["singleImageModality", 0, "singleImageSeriesStack"]]
  }
}
