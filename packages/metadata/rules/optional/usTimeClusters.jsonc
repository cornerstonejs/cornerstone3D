// Ultrasound: one display set for each sweep.
//
// An ultrasound series can hold the single images of several sweeps. The
// default rules put all of the single images in one stack. With this rule,
// each sweep becomes its own display set, in time order. A sweep is a run of
// images with no gap in time longer than `timeClustersMaxGap` seconds. The
// description gets the start of the sweep, in seconds from the first image of
// the series.
//
// The rule claims single-frame US images that have a time, and only in a series
// with two or more sweeps. Multi-frame clips stay with the default `multiFrame`
// rule.
//
// The file puts the rule just before the default `defaultImageRule` rule, which
// would otherwise take the single US images as one display set.
// `$spliceById` needs `spliceById` of @cornerstonejs/metadata, registered with
// immutability-helper `extend`.
{
  // New rules for the registry.
  "displaySetRules": {
    "$merge": {
      "usTimeClusters": {
        "description": "Ultrasound single images: one display set for each sweep of contiguous acquisition time.",
        // 20 s for this rule; the default context uses 30 s.
        "context": { "timeClustersMaxGap": 20 },
        "matches": {
          "isImage": true,
          "Modality": "US",
          "isMultiFrame": false,
          "sweepCount": { "greaterThan": 1 },
          "sweepStart": { "notNull": true }
        },
        "groupBy": ["SeriesInstanceUID", "sweepStart"],
        "sortBy": ["acquisitionSeconds"],
        "attributes": {
          "SeriesDescription": {
            "template": "{SeriesDescription} +{sweepOffset} s"
          }
        }
      }
    }
  },
  "displaySetRuleOrder": {
    "$spliceById": [["defaultImageRule", 0, "usTimeClusters"]]
  }
}
