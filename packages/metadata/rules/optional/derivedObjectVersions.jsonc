// SR and SEG: one display set for each version.
//
// A series of structured reports or segmentations can hold more than one
// version of the object. The default rules make one display set for each
// series. With these rules, each SR or SEG instance becomes its own display
// set. The display sets are in the order of ContentDate and ContentTime, so the
// newest version is last. `isLatestVersion` is true on the display set of the
// newest version of the series.
//
// `contentStamp` is ContentDate and ContentTime as one number,
// `YYYYMMDDhhmmss.ffffff`. `isLatestVersion` compares it with the maximum of
// the series. Each rule holds both names in its own `context`.
//
// `isLatestVersion` is correct for a split of the whole series. A host that
// adds new instances to the display sets of an earlier split (OHIF does) does
// not compute the value of an earlier display set again, so after a new
// version arrives, two display sets can have `isLatestVersion: true`.
//
// The stamp needs ContentTime in the form `hhmmss`. A time `hhmm` (for example
// `1200`) gives a smaller stamp than `090000`, so that version sorts first, and
// `isLatestVersion` can mark the wrong version. Two versions in the same second
// can also sort in the wrong order, because the split key compares the digits
// of the fraction as one number.
//
// Each rule keeps the handler of the default rule, so the host builds the
// display set with its SR or SEG code.
//
// Priority -1: the rules run before every default rule.
{
  "structuredReportVersions": {
    "priority": -1,
    "description": "Structured reports: one display set for each instance, in content date order, with isLatestVersion.",
    "handler": "structuredReport",
    "context": {
      "contentStamp": "Number(ContentDate) * 1000000 + max(Number(ContentTime), 0)",
      "isLatestVersion": "contentStamp == series.instances.max(contentStamp)"
    },
    "matches": {
      "isStructuredReport": true
    },
    "groupBy": ["SeriesInstanceUID", "contentStamp", "SOPInstanceUID"],
    "attributes": {
      "Manufacturer": "Manufacturer",
      "ManufacturerModelName": "ManufacturerModelName",
      "isLatestVersion": "isLatestVersion"
    }
  },
  "segmentationVersions": {
    "priority": -1,
    "description": "Segmentations: one display set for each instance, in content date order, with isLatestVersion.",
    "handler": "segmentation",
    "context": {
      "contentStamp": "Number(ContentDate) * 1000000 + max(Number(ContentTime), 0)",
      "isLatestVersion": "contentStamp == series.instances.max(contentStamp)"
    },
    "matches": {
      "isSegmentation": true
    },
    "groupBy": ["SeriesInstanceUID", "contentStamp", "SOPInstanceUID"],
    "attributes": {
      "isLatestVersion": "isLatestVersion"
    }
  }
}
