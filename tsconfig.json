{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "./packages",
    "paths": {
      "@cornerstonejs/metadata": ["metadata/src"],
      "@cornerstonejs/metadata/*": ["metadata/src/*"],
      "@cornerstonejs/core": ["core/src"],
      "@cornerstonejs/core/renderBackend": ["core/src/renderBackend"],
      "@cornerstonejs/core/utilities": ["core/src/utilities"],
      "@cornerstonejs/core/enums": ["core/src/enums"],
      "@cornerstonejs/core/loaders": ["core/src/loaders"],
      "@cornerstonejs/core/loaders/*": ["core/src/loaders/*"],
      "@cornerstonejs/core/types": ["core/src/types"],
      "@cornerstonejs/core/types/*": ["core/src/types/*"],
      "@cornerstonejs/rendering-webgpu-vtkjs": ["rendering-webgpu-vtkjs/src"],
      "@cornerstonejs/tools": ["tools/src"],
      "@cornerstonejs/dicomImageLoader": ["dicomImageLoader/src"],
      "@cornerstonejs/nifti-volume-loader": ["nifti-volume-loader/src"],
      "@cornerstonejs/ai": ["ai/src"],
      "@cornerstonejs/labelmap-interpolation": ["labelmap-interpolation/src"],
      "@cornerstonejs/polymorphic-segmentation": [
        "polymorphic-segmentation/src"
      ],
      "@cornerstonejs/adapters": ["adapters/src"]
    }
  }
}
